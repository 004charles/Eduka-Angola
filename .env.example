# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set USE_SQLITE=True to use SQLite for local development if you don't have PostGIS set up
USE_SQLITE=False
DB_NAME=eduka_db
DB_USER=db_user
DB_PASSWORD=db_password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
EMAIL_HOST_USER=edukangola@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=your-edukangola@gmail.com

# Optional one-time administrator bootstrap for production.
# Define these only in the hosting provider, never in Git.
ADMIN_BOOTSTRAP_EMAIL=admin@your-domain.example
ADMIN_BOOTSTRAP_NAME=Administrador Edukangola
ADMIN_BOOTSTRAP_PASSWORD=generate-a-strong-unique-password
# Temporary token required only while the /admin "Criar conta" option is enabled.
ADMIN_BOOTSTRAP_TOKEN=generate-a-long-random-token-and-remove-after-first-admin

# Redis Configuration (Optional)
REDIS_URL=redis://127.0.0.1:6379/1
